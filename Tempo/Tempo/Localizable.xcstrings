        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista è già al minimo."
          }
        }
      }
    },
    "The mean of your daily recovery scores, over the days that have a reading. Days with no reading are left out." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La media dei tuoi punteggi di recupero giornalieri, sui giorni con una lettura. I giorni senza lettura sono esclusi."
          }
