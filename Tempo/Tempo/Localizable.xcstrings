    },
    "The planner only programs recipes you can make." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pianificatore programma solo ricette che puoi fare."
          }
