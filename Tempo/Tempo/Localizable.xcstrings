    },
    "The total weight you lifted on this exercise over the last 30 days." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il peso totale che hai sollevato in questo esercizio negli ultimi 30 giorni."
          }
        }
      }
    },
    "The two weights don't look right together. Step on the scale again, in the same clothes." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
