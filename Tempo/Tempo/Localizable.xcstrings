            "state" : "translated",
            "value" : "Tieni il bilanciere vicino al viso, poi porta la testa in avanti"
          }
        }
      }
    },
    "Keep the forehead down; the arms hover the whole way." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fronte a terra; le braccia restano sospese per tutto il movimento."
