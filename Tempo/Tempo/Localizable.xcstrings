    "\"3 non-negotiables left. Clock's ticking. Move.\"" : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"3 non negoziabili rimasti. Il tempo scorre. Muoviti.\""
          }
        }
      }
    },
    "\"3 tasks remaining. 5 hours left. Time to focus.\"" : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"3 attività rimaste. Mancano 5 ore. Concentrati.\""
          }
        }
      }
    },
    "\"3 tasks undone. Another wasted day incoming. Prove me wrong.\"" : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"3 attività non fatte. Un altro giorno sprecato in arrivo. Dimostra che mi sbaglio.\""
          }
        }
      }
    },
    "\"Hey! You've got 3 tasks left today. You can totally do this!\"" : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Ehi! Hai ancora 3 attività oggi. Ce la puoi fare, davvero!\""
          }
        }
      }
    },
    "\"I'm out of rice\", \"I used half the chicken\", \"move the salmon to the freezer\"" : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Ho finito il riso\", \"Ho usato metà del pollo\", \"sposta il salmone nel freezer\""
          }
        }
      }
    },
    "\"RDL +5kg\", \"skip the sprints Thursday, knee\", \"togli gli sprint giovedì\" — Tempo turns it into changes you review before anything's applied." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"RDL +5kg\", \"salta gli sprint giovedì, ginocchio\", \"skip the sprints Thursday\" — Tempo lo trasforma in modifiche che controlli tu prima che venga applicato qualcosa."
          }
        }
      }
    },
