    "Friends only share their name, their level and this week's XP: nothing else leaves their phone. The week runs Monday to Sunday and starts again from zero on Monday." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli amici condividono solo il nome, il livello e gli XP di questa settimana: nient'altro lascia il loro telefono. La settimana va da lunedì a domenica e riparte da zero il lunedì."
          }
        }
      }
    },
