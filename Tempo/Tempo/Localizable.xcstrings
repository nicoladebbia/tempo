      }
    },
    "The notification buttons use this size." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pulsanti delle notifiche usano questa misura."
          }
        }
      }
    },
    "The number comes from the product's data source. It is shown as given and does not change the Tempo score." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
