      }
    },
    "Your plan" : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo piano"
          }
        }
      }
    },
    "Your plan decides each day whether to take this and when. You don't have to schedule it. These facts just help it (servings per container is what a restock resets servings-left to)." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo piano decide ogni giorno se prenderlo e quando. Non devi programmarlo. Questi dati lo aiutano soltanto (un rifornimento riporta le porzioni rimaste al numero di porzioni per confezione)."
          }
        }
      }
    },
    "Your plan is adjusted while this is on." : {
      "extractionState" : "automatic",
      "localizations" : {
