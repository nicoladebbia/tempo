        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua posizione"
          }
        }
      }
    },
    "Your reading now" : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua lettura attuale"
          }
        }
      }
    },
    "Your real maintenance" : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo mantenimento reale"
          }
        }
      }
    },
    "Your recovery (%lld%%) is below optimal for a full training session. Pushing through yellow/red recovery repeatedly leads to overtraining and plateaus." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo recupero (%lld%%) è sotto il livello ottimale per una sessione completa. Forzare ripetutamente con recupero giallo o rosso porta a sovrallenamento e plateau."
          }
        }
      }
    },
    "Your recovery is %lld%%. Consider a lighter workout today." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo recupero è al %lld%%. Oggi meglio un allenamento più leggero."
          }
        }
      }
    },
    "Your recovery is RED today (%lld%%). Consider rest or light mobility. Don't push through this." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo recupero oggi è ROSSO (%lld%%). Meglio riposo o mobilità leggera. Non forzare."
          }
        }
      }
    },
    "Your recovery score averaged over every day in this period that has a reading." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo punteggio di recupero, in media su ogni giorno di questo periodo con una misurazione."
          }
        }
      }
    },
    "Your recovery score is %lld%%, which is in the red zone. Training hard today increases injury risk and delays adaptation." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo punteggio di recupero è %lld%%, in zona rossa. Allenarti duro oggi aumenta il rischio di infortunio e ritarda l'adattamento."
          }
        }
      }
    },
    "Your recovery score this week, averaged." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo punteggio di recupero di questa settimana, in media."
