      }
    },
    "Sit with both knees bent at 90° — one leg in front, one to the side. Keeping the chest tall, rotate both knees together over to the other side and back. Hands down for support if needed." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siediti con entrambe le ginocchia piegate a 90° — una gamba davanti, una di lato. Con il petto alto, ruota le due ginocchia insieme dall'altra parte e torna indietro. Se serve, appoggia le mani a terra per sostenerti."
          }
        }
      }
    },
    "Sit with one shin in front and one out to the side, both knees at 90°, and rotate the knees from one side to the other without using your hands." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siediti con uno stinco davanti e uno di lato, entrambe le ginocchia a 90°, e ruota le ginocchia da un lato all'altro senza usare le mani."
          }
        }
      }
    },
