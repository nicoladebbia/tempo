            "state" : "translated",
            "value" : "La quota del tempo a letto in cui hai davvero dormito."
          }
        }
      }
    },
    "The share of your weight that is fat, as a percentage, from Apple Health." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quota del tuo peso che è grasso, in percentuale, da Apple Salute."
          }
        }
      }
    },
    "The single day on which you studied the most." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il giorno in cui hai studiato di più."
          }
        }
      }
    },
    "The stops on the way: 3, 5, 7, 14, 21, 30, 50 and 100 days." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I traguardi lungo la strada: 3, 5, 7, 14, 21, 30, 50 e 100 giorni."
          }
        }
      }
    },
    "The temperature of your skin overnight, in degrees Celsius." : {
      "extractionState" : "automatic",
      "localizations" : {
