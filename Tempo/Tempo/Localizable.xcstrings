          }
        }
      }
    },
    "Keep going until it is full. A set you skip is removed from the plan, so it stops counting." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua fino a completare tutte le serie. Una serie che salti viene tolta dal piano, quindi non conta più."
