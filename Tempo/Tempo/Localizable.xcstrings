    "Dumbbell — short handheld weights, one per hand. Better for balance and one-arm work." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manubri — pesi corti da impugnare, uno per mano. Ideali per l'equilibrio e il lavoro a un braccio."
