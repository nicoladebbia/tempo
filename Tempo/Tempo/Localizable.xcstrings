    },
    "The volume of each session in the last 30 days, added up. A session's volume is weight × reps for its working sets." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il volume di ogni sessione degli ultimi 30 giorni, sommato. Il volume di una sessione è peso × ripetizioni delle sue serie di lavoro."
          }
