        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua lista della spesa"
          }
        }
      }
    },
    "Your skin temperature is +%@°C above your baseline. This may indicate inflammation, fever, or oncoming illness." : {
