    "Knees track out over your toes" : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ginocchia seguono la direzione delle punte dei piedi"
          }
        }
      }
    },
    "Knees wide, big toes together, sit back onto the heels and walk the hands long. Forehead down. Slow nasal breaths — in for 4, out for 6." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginocchia larghe, alluci uniti, siediti sui talloni e porta le mani in avanti il più possibile. Fronte a terra. Respiri lenti dal naso — inspira per 4, espira per 6."
          }
        }
      }
    },
