          "stringUnit" : {
            "state" : "translated",
            "value" : "Il piano sta richiedendo più del solito. Comparirà appena è pronto."
          }
        }
      }
    },
    "The plan was rebuilt since this reminder was set." : {
      "extractionState" : "automatic",
