    "You and %@ are friends" : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu e %@ siete amici"
          }
        }
      }
    },
    "You are ahead. Keep the same effort and log your next reading to confirm it." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei in anticipo. Mantieni lo stesso ritmo e registra la prossima lettura per confermarlo."
          }
        }
      }
    },
    "You are already friends" : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siete già amici"
          }
        }
      }
    },
    "You are already there. Pick a harder target." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci sei già. Scegli un obiettivo più difficile."
          }
        }
      }
    },
    "You are behind. Do your next session or meal on time, or move the date in the goal." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei in ritardo. Fai la prossima sessione o il prossimo pasto in orario, oppure sposta la data nell'obiettivo."
          }
        }
      }
    },
    "You are in the green. Your body can take a normal training day, so train as planned." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei nel verde. Il tuo corpo regge un normale giorno di allenamento: allenati come da piano."
          }
        }
      }
    },
    "You are in the red. Swap the hard session for a walk or mobility and get to bed early tonight." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei nel rosso. Sostituisci la sessione dura con una camminata o con la mobilità e stasera vai a letto presto."
          }
        }
      }
    },
    "You are in the yellow. Keep today's session moderate and stop a set or two short of your limit." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei nel giallo. Tieni moderata la sessione di oggi e fermati una o due serie prima del tuo limite."
          }
        }
      }
    },
    "You are on track. Keep going and log your next reading." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei in linea. Continua così e registra la prossima lettura."
          }
        }
      }
    },
    "You are set up. Health and Whoop make Tempo sharper but are optional." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai finito la configurazione. Salute e Whoop rendono Tempo più preciso, ma sono facoltativi."
          }
        }
      }
    },
    "You are signed in with Apple. One more thing before we start." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai effettuato l'accesso con Apple. Ancora una cosa prima di iniziare."
          }
        }
      }
    },
    "You can already see each other on the leaderboard." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi vedete già in classifica."
          }
        }
      }
    },
    "You can only do that with friends." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi farlo solo con gli amici."
          }
        }
      }
    },
    "You can still plan a week by hand." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi sempre pianificare una settimana a mano."
          }
        }
      }
    },
    "You don't have permission to do that." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai il permesso di farlo."
          }
        }
      }
    },
    "You earned it. Enjoy your evening." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te lo sei guadagnato. Goditi la serata."
          }
        }
      }
    },
    "You enter it. For a set, Tempo reads it as reps in reserve (10 minus RPE); a session rating is read by your coach the next day." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo inserisci tu. Per una serie, Tempo lo legge come ripetizioni in riserva (10 meno RPE); il voto di una sessione lo legge il tuo coach il giorno dopo."
          }
        }
      }
    },
    "You entered %@." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai inserito %@."
          }
        }
      }
    },
    "You got %@ hours of sleep. Cognitive performance and muscle recovery both drop significantly below 7 hours." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai dormito %@ ore. Sotto le 7 ore calano sensibilmente sia le prestazioni cognitive sia il recupero muscolare."
          }
        }
      }
    },
    "You got %@h of sleep and have only logged %lld/%lld meals. Sleep deprivation disrupts hunger hormones and decision-making, leading to skipped meals or poor choices." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai dormito %@h e hai registrato solo %lld/%lld pasti. La privazione di sonno altera gli ormoni della fame e la capacità di decidere, e porta a pasti saltati o scelte sbagliate."
          }
        }
      }
    },
    "You got there. Set a new goal to keep going." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce l'hai fatta. Imposta un nuovo obiettivo per continuare."
          }
        }
      }
    },
    "You have %@ planned for today and haven't started yet. Consistency beats intensity — showing up matters more than having a perfect session." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi hai %@ in programma e non hai ancora iniziato. La costanza batte l'intensità — presentarsi conta più di una sessione perfetta."
          }
        }
      }
    },
    "You have %lld tasks left today. Finish them all to add a day." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai ancora %lld attività oggi. Completale tutte per aggiungere un giorno."
          }
        }
      }
    },
    "You have 1 task left today. Finish it to add a day." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti resta 1 attività oggi. Completala per aggiungere un giorno."
          }
        }
      }
    },
    "You have filled both halves today." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi hai riempito entrambe le metà."
          }
        }
      }
    },
    "You have full access to Tempo Pro." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai accesso completo a Tempo Pro."
          }
        }
      }
    },
    "You have no grocery list yet. Build your weekly plan first, then add it." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai ancora una lista della spesa. Crea prima il piano settimanale, poi aggiungilo."
          }
        }
      }
    },
    "You have reached today's study target." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai raggiunto l'obiettivo di studio di oggi."
          }
        }
      }
    },
    "You have reached your calorie target. Keep logging so tomorrow's targets stay accurate." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai raggiunto il tuo obiettivo calorico. Continua a registrare così gli obiettivi di domani restano precisi."
          }
        }
      }
    },
    "You have room to push harder. Your recovery supports more training stimulus." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai margine per spingere di più. Il tuo recupero regge uno stimolo di allenamento maggiore."
          }
        }
      }
    },
    "You haven't started studying yet. %lldmin left to hit your target. Open Tempo and start a timer." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai ancora iniziato a studiare. Mancano %lld min all'obiettivo. Apri Tempo e fai partire un timer."
          }
        }
      }
    },
    "You lead the week" : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guidi la settimana"
          }
        }
      }
    },
    "You left %@." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai abbandonato %@."
          }
        }
      }
    },
    "You lost %@ kg on the scale (%@%% of your weight)." : {
      "extractionState" : "automatic",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
