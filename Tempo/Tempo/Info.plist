<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ANTHROPIC_API_KEY</key>
	<string>__ANTHROPIC_API_KEY__</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.tempo.healthkit-sync</string>
		<string>com.tempo.data-sync</string>
		<string>com.tempo.daily-reset</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>app.tempo.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tempo</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSCameraUsageDescription</key>
	<string>Tempo uses the camera to scan food barcodes, photograph products and nutrition labels, scan grocery receipts for your pantry, and photograph your trainer's workout program.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Tempo reads product and nutrition-label photos, receipts and your trainer's workout programs from your photo library to import them.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Tempo can save your weekly grocery list to Reminders so you can check items off while shopping.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Tempo can save your weekly grocery list to Reminders so you can check items off while shopping.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>TEMPO_API_BASE_URL</key>
	<string>__TEMPO_API_BASE_URL__</string>
	<key>TEMPO_ENVIRONMENT</key>
	<string>__TEMPO_ENVIRONMENT__</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>tempo-bg-primary</string>
	</dict>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
