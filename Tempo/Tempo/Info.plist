<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.tempo.healthkit-sync</string>
		<string>com.tempo.data-sync</string>
		<string>com.tempo.daily-reset</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>processing</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>$(BUNDLE_DISPLAY_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>app.tempo.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tempo</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>TEMPO_API_BASE_URL</key>
	<string>__TEMPO_API_BASE_URL__</string>
	<key>TEMPO_ENVIRONMENT</key>
	<string>__TEMPO_ENVIRONMENT__</string>
	<key>NSCameraUsageDescription</key>
	<string>Tempo uses the camera to scan grocery receipts so it can fill your pantry and price-track items automatically.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Tempo reads receipts from your photo library to import them into your pantry.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Tempo reads your calendar to flag meals that fall during busy blocks as "portable only" so you can prep ahead.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Tempo reads your calendar to flag meals that fall during busy blocks as "portable only" so you can prep ahead.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Tempo can save your weekly grocery list to Reminders so you can check items off while shopping.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Tempo can save your weekly grocery list to Reminders so you can check items off while shopping.</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>tempo-bg-primary</string>
	</dict>
</dict>
</plist>
