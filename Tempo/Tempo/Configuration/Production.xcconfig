// Production.xcconfig

#include? "Secrets.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = app.tempo.Tempo
PRODUCT_NAME = Tempo
// Home-screen / Settings label. PRODUCT_NAME stays "Tempo" (executable
// name); the user-facing string is "Tempo OS" because the bare "Tempo"
// is taken on the App Store. Per LAUNCH_PUNCH_LIST.md §1.2 follow-up.
BUNDLE_DISPLAY_NAME = Tempo OS
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// Railway-hosted Vapor backend. Auto-generated subdomain — swap for a
// custom domain (e.g. api.tempo.app) when DNS is configured.
TEMPO_API_BASE_URL = https:/$()/tempo-backend-production-39dc.up.railway.app
TEMPO_ENVIRONMENT = production

SWIFT_ACTIVE_COMPILATION_CONDITIONS = PRODUCTION
GCC_OPTIMIZATION_LEVEL = s
SWIFT_OPTIMIZATION_LEVEL = -O
ENABLE_TESTABILITY = NO

// Strip debug symbols for release
STRIP_INSTALLED_PRODUCT = YES
COPY_PHASE_STRIP = YES

INFOPLIST_PREPROCESS = YES
INFOPLIST_PREPROCESSOR_DEFINITIONS = __TEMPO_API_BASE_URL__=$(TEMPO_API_BASE_URL) __TEMPO_ENVIRONMENT__=$(TEMPO_ENVIRONMENT)
INFOPLIST_OTHER_PREPROCESSOR_FLAGS = -traditional
