// Development.xcconfig

#include? "Secrets.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = app.tempo.Tempo.dev
PRODUCT_NAME = Tempo Dev
// Keep the Swift module name stable across configurations so tests can
// `@testable import Tempo` regardless of which build config is active.
PRODUCT_MODULE_NAME = Tempo
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

TEMPO_API_BASE_URL = http:/$()/localhost:8080
TEMPO_ENVIRONMENT = development

// Enable Info.plist preprocessing so xcconfig values reach Bundle.main at runtime.
// Without this, custom user-defined keys land as empty strings in the bundled
// Info.plist. Tokens are wrapped in `__VAR__` to avoid colliding with their own
// <key> elements during macro expansion.
INFOPLIST_PREPROCESS = YES
INFOPLIST_PREPROCESSOR_DEFINITIONS = __TEMPO_API_BASE_URL__=$(TEMPO_API_BASE_URL) __TEMPO_ENVIRONMENT__=$(TEMPO_ENVIRONMENT)
INFOPLIST_OTHER_PREPROCESSOR_FLAGS = -traditional

// Debug-only flags
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG DEVELOPMENT
OTHER_SWIFT_FLAGS = -DDEBUG
GCC_OPTIMIZATION_LEVEL = 0
SWIFT_OPTIMIZATION_LEVEL = -Onone
ENABLE_TESTABILITY = YES

// Debug logging
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) DEBUG=1
